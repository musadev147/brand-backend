# ============================================
# Brand Bridge — Environment Variables
# ============================================

# App Settings
APP_NAME=BrandBridge
APP_ENV=development
DEBUG=true

# Database (SQLite for dev, PostgreSQL for prod)
# SQLite:
DATABASE_URL=sqlite:///./brand_bridge.db
# PostgreSQL (uncomment for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/brand_bridge

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP Settings
OTP_EXPIRE_MINUTES=10

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Mail (uncomment when ready)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=noreply@brandbrige.com

RESEND_API_KEY=re_YOUR_KEY_HERE
FROM_EMAIL=onboarding@resend.dev
